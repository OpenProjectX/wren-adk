# Copy to .env and fill in. Loaded automatically at startup by spring-dotenv.
# .env is gitignored — never commit real keys.

# --- LLM provider -----------------------------------------------------------
# ANTHROPIC or GEMINI
WREN_ADK_PROVIDER=ANTHROPIC

# Anthropic (provider=ANTHROPIC)
ANTHROPIC_API_KEY=
# Optional: route through a gateway that speaks the Anthropic API
# ANTHROPIC_BASE_URL=

# Google (provider=GEMINI)
# GOOGLE_API_KEY=

# Optional: override the model. Blank uses the provider default
# (claude-sonnet-4-5 / gemini-2.0-flash).
# WREN_ADK_MODEL=

# --- Wren -------------------------------------------------------------------
# A built Wren project: wren_project.yml, models/, target/mdl.json
WREN_PROJECT_HOME=/project

# STDIO spawns `wren serve mcp` as a child process (needs the CLI on PATH).
# STREAMABLE_HTTP talks to a sidecar or service instead.
WREN_ADK_TRANSPORT=STDIO
# WREN_MCP_URL=http://127.0.0.1:8080/mcp
