# Copy to .env and fill in. Loaded automatically at startup by spring-dotenv.
# .env is gitignored — never commit real keys.

# --- LLM provider -----------------------------------------------------------
# ANTHROPIC or GEMINI (case-insensitive).
LLM_PROVIDER=anthropic

# --- Anthropic, or any Anthropic-compatible endpoint ------------------------
# Use ONE of these two, depending on what your endpoint expects:
#   ANTHROPIC_API_KEY    -> sent as `x-api-key`        (api.anthropic.com)
#   ANTHROPIC_AUTH_TOKEN -> sent as `Authorization: Bearer` (most gateways)
# If both are set, the bearer token wins.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Leave blank for api.anthropic.com, or point at a compatible gateway, e.g.
# an Aliyun MaaS endpoint serving Qwen through the Anthropic API shape.
# ANTHROPIC_BASE_URL=

# Model name as the endpoint knows it — a gateway may serve a non-Claude model.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google (LLM_PROVIDER=gemini) -------------------------------------------
# GOOGLE_API_KEY=

# Overrides the model for whichever provider is active.
# WREN_ADK_MODEL=

# --- Wren -------------------------------------------------------------------
# A built Wren project: wren_project.yml, models/, target/mdl.json
WREN_PROJECT_HOME=/project

# STDIO spawns `wren serve mcp` as a child process (needs the CLI on PATH).
# STREAMABLE_HTTP talks to a sidecar or service instead.
WREN_ADK_TRANSPORT=STDIO
# WREN_MCP_URL=http://127.0.0.1:8080/mcp
